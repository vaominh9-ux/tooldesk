# ==========================================
# SUPABASE & DATABASE CONFIGURATION TEMPLATE
# ==========================================
SUPABASE_URL=https://jqkezzjkcyulkrmtrwgj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_USER_EMAIL=vaominh9@gmail.com
SUPABASE_DB_PASSWORD=your_db_password

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jqkezzjkcyulkrmtrwgj.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jqkezzjkcyulkrmtrwgj.supabase.co:5432/postgres

# Backend mode and protected reminder worker
APP_DATA_SOURCE=mock
APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-secret
REMINDER_SEND_HOUR=9
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_CA_CERT="..." # Optional if using custom CA, or defaults to supabase/certs/prod-ca-2021.crt

# SMTP stays disabled until explicitly enabled and configured
EMAIL_SEND_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Tooldesk <no-reply@example.com>

# 32-byte key encoded as 64 hex characters, stored only on server.
# Required for saving SMTP settings from the admin interface.
SMTP_CONFIG_ENCRYPTION_KEY=
